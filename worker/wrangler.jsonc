{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flyradar-ksu",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRACK_STORE",
        "class_name": "TrackStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrackStore"]
    }
  ]
}
